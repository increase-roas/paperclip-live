# Editor and formatter defaults.
# The CI formatter (scripts/check-source-format.mjs) enforces the mechanical
# rules below for every tracked file. Keep these settings aligned with it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
